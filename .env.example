# ---------------------------------------------------------------------------
# jadx-mcp-server — container configuration
#
#   cp .env.example .env    then edit .env (it is git-ignored)
#
# Compose reads this file twice: for ${...} interpolation in docker-compose.yml
# and as the container's env_file. Every knob lives here, not in the compose
# file.
# ---------------------------------------------------------------------------

# --- Image -----------------------------------------------------------------
# Published by .github/workflows/docker-publish.yml. Use a version tag
# (e.g. v3.3.5) rather than latest for reproducible deployments.
IMAGE=ghcr.io/applone/jadx-mcp-server
IMAGE_TAG=latest

# --- MCP listener ----------------------------------------------------------
# Port the MCP endpoint is served on, inside and outside the container.
MCP_PORT=8651

# Address the server binds INSIDE the container.
# Keep 127.0.0.1 unless you have configured OAuth below — the server refuses a
# non-loopback bind without it.
MCP_HOST=127.0.0.1

# Host interface the port is published on. 127.0.0.1 keeps the endpoint
# reachable only from this machine. Change to 0.0.0.0 only with OAuth enabled.
MCP_PUBLISH_ADDR=127.0.0.1

# Expose the loopback listener through the published port via an in-container
# relay. This adds NO authentication — it is the "local dev, trusted machine"
# switch. For anything reachable by others, set this to false and configure
# OAuth instead.
JADX_MCP_ALLOW_INSECURE_BIND=true

# Loopback port the server binds when the relay above is active. Only change
# this if 18651 collides with something in the container.
MCP_INTERNAL_PORT=18651

# --- JADX-GUI plugin bridge ------------------------------------------------
# Where the JADX AI MCP plugin is listening. JADX-GUI normally runs on the
# Docker host, so host.docker.internal is the default (docker-compose.yml maps
# it to the host gateway on Linux). Use a hostname/IP for a remote JADX.
JADX_HOST=host.docker.internal
JADX_PORT=8650

# --- Resource limits -------------------------------------------------------
MEMORY_LIMIT=1g
CPU_LIMIT=2

# ---------------------------------------------------------------------------
# Public MCP OAuth (optional) — required to bind a non-loopback MCP_HOST.
# Full reference: OAUTH.md. Uncomment and fill in for a shared deployment.
# ---------------------------------------------------------------------------
# JADX_MCP_OAUTH_MODE=remote
# JADX_MCP_OAUTH_PUBLIC_BASE_URL=https://mcp.example.com
# JADX_MCP_OAUTH_PUBLIC_AUDIENCE=https://mcp.example.com/mcp
# JADX_MCP_OAUTH_AUTHORIZATION_SERVERS=https://auth.example.com
# JADX_MCP_OAUTH_PUBLIC_TOKEN_VALIDATION=jwt
# JADX_MCP_OAUTH_PUBLIC_JWKS_URI=https://auth.example.com/.well-known/jwks.json
# JADX_MCP_OAUTH_PUBLIC_JWT_ALGORITHM=RS256

# --- Proxy mode only -------------------------------------------------------
# JADX_MCP_OAUTH_UPSTREAM_ISSUER=https://auth.example.com
# JADX_MCP_OAUTH_UPSTREAM_CLIENT_ID=
# JADX_MCP_OAUTH_UPSTREAM_CLIENT_SECRET=
# JADX_MCP_OAUTH_UPSTREAM_AUTHORIZATION_ENDPOINT=https://auth.example.com/authorize
# JADX_MCP_OAUTH_UPSTREAM_TOKEN_ENDPOINT=https://auth.example.com/token
# JADX_MCP_OAUTH_PROXY_JWT_SIGNING_KEY=
# JADX_MCP_OAUTH_ALLOWED_CLIENT_REDIRECT_URIS=

# ---------------------------------------------------------------------------
# Plugin-side OAuth (optional) — client-credentials token for the Java plugin.
# Only needed when the JADX plugin itself requires authorization.
# ---------------------------------------------------------------------------
# JADX_PLUGIN_OAUTH_TOKEN_URL=https://auth.example.com/token
# JADX_PLUGIN_OAUTH_CLIENT_ID=
# JADX_PLUGIN_OAUTH_CLIENT_SECRET=
# JADX_PLUGIN_OAUTH_RESOURCE=https://jadx-plugin.example.com
