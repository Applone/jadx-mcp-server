# ---------------------------------------------------------------------------
# jadx-mcp-server — container configuration
#
#   cp .env.example .env    then edit .env (it is git-ignored)
#
# Compose reads this file twice: for ${...} interpolation in docker-compose.yml
# and as the container's env_file. Every knob lives here, not in the compose
# file.
# ---------------------------------------------------------------------------

# --- Image -----------------------------------------------------------------
# Published by .github/workflows/docker-publish.yml. Use a version tag
# (e.g. v3.3.5) rather than latest for reproducible deployments.
IMAGE=ghcr.io/applone/jadx-mcp-server
IMAGE_TAG=latest

# How Compose obtains the image:
#   missing — pull from GHCR when it isn't already in the local cache (default)
#   always  — pull every `up`, so a moving tag like latest stays current
#   never   — use only what's cached locally
#   build   — always build from this checkout instead of pulling
# Building is otherwise opt-in via `docker compose up --build`.
PULL_POLICY=missing

# --- MCP listener ----------------------------------------------------------
# Port the MCP endpoint is served on, inside and outside the container.
MCP_PORT=8651

# Address the server binds INSIDE the container.
# Keep 127.0.0.1 unless you have configured OAuth below — the server refuses a
# non-loopback bind without it.
MCP_HOST=127.0.0.1

# Host interface the port is published on. 127.0.0.1 keeps the endpoint
# reachable only from this machine. Change to 0.0.0.0 only with OAuth enabled.
MCP_PUBLISH_ADDR=127.0.0.1

# Expose the loopback listener through the published port via an in-container
# relay. This adds NO authentication. Safe when the endpoint stays on a
# loopback address that only you can reach (directly, or through an SSH
# tunnel). For an endpoint reachable by others, set this false and configure
# OAuth below.
JADX_MCP_ALLOW_INSECURE_BIND=true

# Address the relay listens on inside the container's network namespace.
#   0.0.0.0    — correct for the default bridge setup; host-side exposure is
#                then controlled by MCP_PUBLISH_ADDR above.
#   127.0.0.1  — REQUIRED with docker-compose.host-net.yml, where the container
#                shares the host's network namespace and 0.0.0.0 would publish
#                an unauthenticated endpoint on every server interface.
RELAY_BIND=0.0.0.0

# Loopback port the server binds when the relay above is active. Only change
# this if 18651 collides with something in the container.
MCP_INTERNAL_PORT=18651

# --- JADX-GUI plugin bridge ------------------------------------------------
# Where the JADX AI MCP plugin is listening. Pick the value that matches how
# JADX reaches this container:
#
#   host.docker.internal  — JADX-GUI runs on the same machine as Docker
#                           (docker-compose.yml maps it to the host gateway).
#   127.0.0.1             — JADX-GUI is on your workstation and forwarded to
#                           this server over an SSH reverse tunnel. Requires
#                           docker-compose.host-net.yml; see README.md.
#   <host-or-ip>          — a JADX instance reachable over the network.
JADX_HOST=host.docker.internal
JADX_PORT=8650

# --- Resource limits -------------------------------------------------------
MEMORY_LIMIT=1g
CPU_LIMIT=2

# ---------------------------------------------------------------------------
# Public MCP OAuth (optional) — required to bind a non-loopback MCP_HOST.
# Full reference: OAUTH.md. Uncomment and fill in for a shared deployment.
# ---------------------------------------------------------------------------
# JADX_MCP_OAUTH_MODE=remote
# JADX_MCP_OAUTH_PUBLIC_BASE_URL=https://mcp.example.com
# JADX_MCP_OAUTH_PUBLIC_AUDIENCE=https://mcp.example.com/mcp
# JADX_MCP_OAUTH_AUTHORIZATION_SERVERS=https://auth.example.com
# JADX_MCP_OAUTH_PUBLIC_TOKEN_VALIDATION=jwt
# JADX_MCP_OAUTH_PUBLIC_JWKS_URI=https://auth.example.com/.well-known/jwks.json
# JADX_MCP_OAUTH_PUBLIC_JWT_ALGORITHM=RS256

# --- Scopes ----------------------------------------------------------------
# Which scopes a client MAY be granted. EXTRA appends to the jadx:* defaults;
# SCOPES_SUPPORTED replaces them outright.
# JADX_MCP_OAUTH_EXTRA_SCOPES=openid,profile,email,groups
# JADX_MCP_OAUTH_SCOPES_SUPPORTED=jadx:read,jadx:write,jadx:debug
#
# Which scopes every token MUST carry. In proxy mode this is ALSO the scope set
# requested from the upstream provider, so OIDC providers such as Authelia that
# reject a request without `openid` need it listed here.
# JADX_MCP_OAUTH_REQUIRED_SCOPES=openid,profile,email
#
# Scope names gating each tool tier. Override when the provider cannot mint
# `jadx:`-prefixed scopes. Each must appear in the advertised list above or the
# server refuses to start.
# JADX_MCP_OAUTH_READ_SCOPE=jadx:read
# JADX_MCP_OAUTH_WRITE_SCOPE=jadx:write
# JADX_MCP_OAUTH_DEBUG_SCOPE=jadx:debug

# --- Proxy mode only -------------------------------------------------------
# JADX_MCP_OAUTH_UPSTREAM_ISSUER=https://auth.example.com
# JADX_MCP_OAUTH_UPSTREAM_CLIENT_ID=
# JADX_MCP_OAUTH_UPSTREAM_CLIENT_SECRET=
# JADX_MCP_OAUTH_UPSTREAM_AUTHORIZATION_ENDPOINT=https://auth.example.com/authorize
# JADX_MCP_OAUTH_UPSTREAM_TOKEN_ENDPOINT=https://auth.example.com/token
# JADX_MCP_OAUTH_PROXY_JWT_SIGNING_KEY=
# JADX_MCP_OAUTH_ALLOWED_CLIENT_REDIRECT_URIS=

# ---------------------------------------------------------------------------
# Plugin-side OAuth (optional) — client-credentials token for the Java plugin.
# Only needed when the JADX plugin itself requires authorization.
# ---------------------------------------------------------------------------
# JADX_PLUGIN_OAUTH_TOKEN_URL=https://auth.example.com/token
# JADX_PLUGIN_OAUTH_CLIENT_ID=
# JADX_PLUGIN_OAUTH_CLIENT_SECRET=
# JADX_PLUGIN_OAUTH_RESOURCE=https://jadx-plugin.example.com
